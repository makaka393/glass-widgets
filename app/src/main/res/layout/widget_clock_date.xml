<?xml version="1.0" encoding="utf-8"?>
<!-- Layers: bg_blur (blurred wallpaper, optional) under bg_tint (surface color, alpha = solidity), then content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bg_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill"
        android:tint="@color/widget_surface"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center">
            <TextClock android:id="@+id/weekday" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:format12Hour="EEEE" android:format24Hour="EEEE" android:gravity="center" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_primary" android:textSize="14sp" />
            <TextClock android:id="@+id/day" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:format12Hour="d" android:format24Hour="d" android:gravity="center" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif-black" android:textColor="@color/widget_on_surface" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="160sp" android:autoSizeStepGranularity="1sp" />
            <TextClock android:id="@+id/month" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:format12Hour="MMMM" android:format24Hour="MMMM" android:gravity="center" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_on_surface" android:textSize="14sp" />
            <TextClock android:id="@+id/time" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:format12Hour="h:mm" android:format24Hour="HH:mm" android:gravity="center" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_on_surface_variant" android:textSize="12sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
