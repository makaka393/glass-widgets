<?xml version="1.0" encoding="utf-8"?>
<!-- Layers: bg_blur (blurred wallpaper, optional) under bg_tint (surface color, alpha = solidity), then content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bg_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill"
        android:tint="@color/widget_surface"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="44dp"
            android:scaleType="fitCenter" android:tint="@color/widget_primary" android:importantForAccessibility="no" />
                <TextView android:id="@+id/temp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="--°" android:textColor="@color/widget_on_surface" android:textSize="44sp" android:fontFamily="sans-serif-light"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:gravity="end" />
            </LinearLayout>
            <TextView android:id="@+id/condition" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:text="Weather" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:gravity="start" />
            <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:text="Tap to set up" android:textColor="@color/widget_on_surface_variant" android:textSize="12sp" android:fontFamily="sans-serif"
            android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:gravity="start" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
