<?xml version="1.0" encoding="utf-8"?>
<!-- Layers: bg_blur (blurred wallpaper, optional) under bg_tint (surface color, alpha = solidity), then content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bg_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill"
        android:tint="@color/widget_surface"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="match_parent">
                <ImageView android:id="@+id/pill_bg" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="fitXY" android:src="@drawable/widget_pill" android:tint="@color/widget_primary_container"
                    android:importantForAccessibility="no" />
                <TextClock android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="match_parent" 
            android:format12Hour="h:mm" android:format24Hour="HH:mm" android:gravity="center" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_on_primary_container" android:textSize="30sp" android:paddingStart="22dp" android:paddingEnd="22dp"/>
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:layout_marginStart="14dp">
                <TextClock android:id="@+id/weekday" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:format12Hour="EEEE" android:format24Hour="EEEE" android:gravity="start" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_on_surface" android:textSize="16sp" />
                <TextClock android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" 
            android:format12Hour="d MMMM" android:format24Hour="d MMMM" android:gravity="start" android:maxLines="1"
            android:includeFontPadding="false" android:fontFamily="sans-serif" android:textColor="@color/widget_on_surface_variant" android:textSize="14sp" android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
