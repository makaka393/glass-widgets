<?xml version="1.0" encoding="utf-8"?>
<!-- Layers: bg_blur (blurred wallpaper, optional) under bg_tint (surface color, alpha = solidity), then content. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_shape"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bg_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/bg_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fill"
        android:tint="@color/widget_surface"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <AnalogClock android:id="@+id/analog" android:layout_width="match_parent" android:layout_height="match_parent"
            android:dial="@drawable/clock_dial" android:hand_hour="@drawable/clock_hour"
            android:hand_minute="@drawable/clock_minute" android:hand_second="@drawable/clock_second"
            android:dialTint="@color/widget_primary_container" android:hand_hourTint="@color/widget_primary"
            android:hand_minuteTint="@color/widget_on_primary_container" android:hand_secondTint="@color/widget_tertiary" />
    </FrameLayout>
</FrameLayout>
